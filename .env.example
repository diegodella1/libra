# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://192.168.1.14:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenRouter (LLM para chatbot)
OPENROUTER_API_KEY=your-openrouter-key-here

# Admin
ADMIN_TOKEN=your-admin-token-here

# Acceso al sitio (gate de login)
SITE_TOKEN=your-site-token-here

# OpenAI (embeddings para RAG)
OPENAI_API_KEY=your-openai-key-here

# Documentos originales (servidos via Next.js rewrite → nginx interno)
# NEXT_PUBLIC_DOCS_URL=/documents  # default, no hace falta setear
